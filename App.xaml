<Application x:Class="Painel7X.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="Gold">#F5B91B</Color>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}" />
    <SolidColorBrush x:Key="BgBrush" Color="#090A0D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#111319" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#171A22" />
    <SolidColorBrush x:Key="LineBrush" Color="#292D37" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8D929E" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#101114"/><Setter Property="Background" Value="{StaticResource GoldBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B7BBC5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C0E13"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="{StaticResource GoldBrush}"/></Style>
  </Application.Resources>
</Application>
