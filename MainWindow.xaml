<Window x:Class="Painel7X.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PAINEL 7X" Width="1060" Height="690" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Loaded="Window_Loaded" Closing="Window_Closing">
 <Border Background="{StaticResource BgBrush}" BorderBrush="#343844" BorderThickness="1" CornerRadius="15">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#0D0F14" CornerRadius="15,15,0,0" BorderBrush="#242832" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_Down">
    <Grid Margin="18,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="27" Height="27" CornerRadius="8" Background="{StaticResource GoldBrush}"><TextBlock Text="7X" Foreground="#111" FontWeight="Black" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="PAINEL 7X" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center"/><TextBlock Text="  /  MTA TOOLS" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="38" Padding="0" Background="Transparent" Foreground="#BFC3CC" Click="Minimize_Click"/><Button Content="✕" Width="38" Padding="0" Background="Transparent" Foreground="#BFC3CC" Click="Close_Click"/></StackPanel></Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0E1016" BorderBrush="#242832" BorderThickness="0,0,1,0" CornerRadius="0,0,0,15"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="CONTROLE" Foreground="#666D7B" FontSize="10" FontWeight="Bold" Margin="8,15,0,13"/><Button Style="{StaticResource NavButton}" Content="◈   Visão geral" Click="Home_Click"/><Button Style="{StaticResource NavButton}" Content="◉   Macro de correr" Click="Run_Click"/><Button Style="{StaticResource NavButton}" Content="⚙   Configurações" Click="Settings_Click"/><TextBlock Text="OUTROS MÓDULOS" Foreground="#666D7B" FontSize="10" FontWeight="Bold" Margin="8,24,0,10"/><Button Style="{StaticResource NavButton}" Content="◇   Deagle" IsEnabled="False" Opacity="0.45"/><Button Style="{StaticResource NavButton}" Content="◇   Lite Foot" IsEnabled="False" Opacity="0.45"/><Button Style="{StaticResource NavButton}" Content="◇   Recoil" IsEnabled="False" Opacity="0.45"/></StackPanel><Border DockPanel.Dock="Bottom" Background="#171A22" CornerRadius="10" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="PAINEL 7X" Foreground="{StaticResource GoldBrush}" FontWeight="Bold"/><TextBlock Text="Build inicial • 1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></DockPanel></Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Visão geral" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Gerencie os recursos do Painel 7X." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/></StackPanel><ContentControl x:Name="PageHost" Grid.Row="1"/></Grid></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
